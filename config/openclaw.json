{
  "meta": {
    "lastTouchedVersion": "2026.3.11",
    "lastTouchedAt": "2026-03-15T16:08:10.778Z"
  },
  "env": {
    "TAVILY_API_KEY": "${TAVILY_API_KEY}",
    "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}",
    "NOTION_API_KEY": "${NOTION_API_KEY}"
  },
  "wizard": {
    "lastRunAt": "2026-03-15T16:08:10.730Z",
    "lastRunVersion": "2026.3.11",
    "lastRunCommand": "doctor",
    "lastRunMode": "local"
  },
  "models": {
    "mode": "merge"
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "zai/glm-5"
      },
      "workspace": "${HOME}/.openclaw/workspace",
      "compaction": {
        "mode": "safeguard",
        "reserveTokensFloor": 20000,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 4000
        }
      },
      "sandbox": {
        "mode": "off"
      }
    },
    "list": [
      {
        "id": "main",
        "name": "小助",
        "workspace": "${HOME}/.openclaw/workspace",
        "model": "zai/glm-5"
      },
      {
        "id": "scheduler",
        "name": "日程管家",
        "workspace": "${HOME}/.openclaw/workspace/agents/scheduler",
        "model": "zai/glm-5"
      }
    ]
  },
  "tools": {
    "profile": "coding"
  },
  "bindings": [
    {
      "agentId": "main",
      "match": {
        "channel": "feishu",
        "accountId": "main"
      }
    },
    {
      "agentId": "scheduler",
      "match": {
        "channel": "feishu",
        "accountId": "scheduler"
      }
    }
  ],
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "session": {
    "dmScope": "per-account-channel-peer"
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "boot-md": {
          "enabled": true
        },
        "session-memory": {
          "enabled": true
        }
      }
    }
  },
  "channels": {
    "feishu": {
      "enabled": true,
      "domain": "feishu",
      "connectionMode": "websocket",
      "appId": "${FEISHU_MAIN_APP_ID}",
      "appSecret": "${FEISHU_MAIN_APP_SECRET}",
      "defaultAccount": "main",
      "accounts": {
        "main": {
          "appId": "${FEISHU_MAIN_APP_ID}",
          "appSecret": "${FEISHU_MAIN_APP_SECRET}",
          "botName": "小助",
          "dmPolicy": "allowlist",
          "allowFrom": [
            "${FEISHU_USER_ID}"
          ]
        },
        "scheduler": {
          "appId": "${FEISHU_SCHEDULER_APP_ID}",
          "appSecret": "${FEISHU_SCHEDULER_APP_SECRET}",
          "botName": "日程管家",
          "dmPolicy": "pairing"
        },
        "default": {
          "groupPolicy": "allow",
          "groupAllowFrom": []
        }
      },
      "requireMention": false
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${GATEWAY_AUTH_TOKEN}"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    }
  },
  "skills": {
    "install": {
      "nodeManager": "npm"
    },
    "entries": {
      "1password": {
        "enabled": false
      }
    }
  },
  "plugins": {
    "allow": [
      "openclaw-lark"
    ],
    "entries": {
      "feishu": {
        "enabled": false