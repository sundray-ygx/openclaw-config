# OpenClaw 环境变量模板
# 复制此文件为 .env 并填入真实值

# === API Keys ===
# 百炼 (通义千问)
BAILIAN_API_KEY=your_bailian_api_key_here

# Tavily 搜索
TAVILY_API_KEY=your_tavily_api_key_here

# Firecrawl
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Notion
NOTION_API_KEY=your_notion_api_key_here

# === 飞书配置 ===
# 主机器人
FEISHU_MAIN_APP_ID=your_feishu_main_app_id
FEISHU_MAIN_APP_SECRET=your_feishu_main_app_secret
FEISHU_USER_ID=your_feishu_user_id

# 日程管家机器人
FEISHU_SCHEDULER_APP_ID=your_feishu_scheduler_app_id
FEISHU_SCHEDULER_APP_SECRET=your_feishu_scheduler_app_secret

# === Gateway 配置 ===
GATEWAY_AUTH_TOKEN=your_gateway_auth_token

# === GitHub 配置（用于自动同步）===
GITHUB_TOKEN=your_github_personal_access_token
